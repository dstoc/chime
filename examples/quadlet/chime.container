[Unit]
Description=Chime notification server
After=chime-tailscale.service
BindsTo=chime-tailscale.service
PartOf=chime-tailscale.service

[Container]
Image=chime.build
ContainerName=chime-server
Network=chime-tailscale.container
User=10001:10001
ReadOnly=true
ReadOnlyTmpfs=true
Exec=--origin https://chime.example-tailnet.ts.net --data-dir /var/lib/chime
Volume=%h/.local/share/chime/data:/var/lib/chime:rw,Z
StopTimeout=30

[Service]
Restart=always

[Install]
WantedBy=default.target
